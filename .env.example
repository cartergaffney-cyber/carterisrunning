DATABASE_URL="file:./dev.db"

# Register a dev app at https://www.strava.com/settings/api
# Authorization Callback Domain should be: localhost
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""

# Used to sign the session cookie JWT (any long random string)
SESSION_SECRET=""

# Base URL used to build the Strava OAuth redirect_uri
APP_BASE_URL="http://localhost:3000"

# Web search fallback for trail/ultra race lookup (no key needed for road races via RunSignup).
# Sign up at https://serpapi.com/ — 250 free searches/month, no credit card required.
SEARCH_API_PROVIDER="serpapi"
SERPAPI_API_KEY=""

# Geocoding (address -> lat/lng for club distance ranking) and route
# generation. Sign up at https://mapbox.com — 100K free geocoding requests/month.
MAPBOX_ACCESS_TOKEN=""

# Authenticates the cron -> /api/cron/generate-routes call (any long random string)
CRON_SECRET=""
